# ayane production Postfix — virtual domains via Dovecot LMTP, rspamd milter,
# STARTTLS everywhere, submission authenticated over TLS only.
compatibility_level = 3.6

myhostname = mail.acgsyzx.me
myorigin = $myhostname
mydestination = localhost.$mydomain, localhost
inet_interfaces = all
inet_protocols = ipv4

# Never trust external networks: an unauthenticated foreign MTA must pass the
# policy checks (sender deny list) below.
mynetworks = 127.0.0.0/8

# Virtual mailbox domains (rendered by the control plane).
virtual_mailbox_domains = texthash:/etc/postfix/maps/virtual_domains
virtual_mailbox_maps = texthash:/etc/postfix/maps/virtual_mailboxes
# The literal map comes first and is searched until it answers: an existing
# account, shared mailbox or alias is therefore never rewritten by the
# variant patterns behind it. `variant_aliases` is the rendered Gmail-style
# map (dots / `+tag` folded onto the base mailbox) and is the ONLY table that
# folds an address: it is empty — a no-op table — unless an inbound variant
# switch is on, and with the `+` switch off nothing folds a plus tag at all.
virtual_alias_maps = texthash:/etc/postfix/maps/virtual_aliases, regexp:/etc/postfix/maps/variant_aliases

virtual_alias_domains =
virtual_uid_maps = static:5000
virtual_gid_maps = static:5000
virtual_transport = lmtp:dovecot:24
# `+` is the address extension separator. Folding a tag is NOT implied by
# it: the recipient map above decides that, and `smtpd_recipient_restrictions`
# plus `virtual_mailbox_maps` decide what an unfolded tag does.
recipient_delimiter = +

# TLS — certificates come from the host's certbot tree (volume, read-only).
smtpd_tls_cert_file = /etc/letsencrypt/live/mail.acgsyzx.me/fullchain.pem
smtpd_tls_key_file = /etc/letsencrypt/live/mail.acgsyzx.me/privkey.pem
smtpd_tls_security_level = may
smtpd_tls_protocols = !SSLv2, !SSLv3, !TLSv1, !TLSv1.1
smtpd_tls_mandatory_protocols = !SSLv2, !SSLv3, !TLSv1, !TLSv1.1
smtp_tls_security_level = may
smtp_tls_protocols = !SSLv2, !SSLv3, !TLSv1, !TLSv1.1
smtp_tls_loglevel = 1

# Submission auth is delegated to Dovecot SASL; the submission service in
# master.cf enforces encrypt + auth_only.
smtpd_sasl_type = dovecot
smtpd_sasl_path = inet:dovecot:12345
smtpd_sasl_auth_enable = yes
smtpd_sasl_security_options = noanonymous

smtpd_recipient_restrictions = permit_mynetworks, check_sender_access texthash:/etc/postfix/maps/sender_denylist, permit_sasl_authenticated, reject_unauth_destination

# 2026-11-25 security recon (P1): bind the envelope sender to the logged-in
# identity. Without this an authenticated account could send as ANY address
# on the domain; the map (rendered by the control plane) lists each sender
# with the accounts allowed to use it — a user's own address and every
# shared mailbox they belong to.
smtpd_sender_login_maps = texthash:/etc/postfix/maps/sender_login
smtpd_sender_restrictions = reject_sender_login_mismatch

# Content filter (spam / DKIM signing / headers) via milter.
# 2026-11-25 security recon (P0): the default used to be `accept`, which
# meant a down rspamd silently disabled every SPF/DKIM/DMARC REJECT policy —
# forged `p=reject` senders sailed through whenever rspamd was unreachable.
# Policy refusals must fail closed; only add-header actions may fail open.
# `tempfail`, not `reject`: a 4xx makes the sending MTA retry and keeps
# the mail in ITS queue until the filter is back — fail-closed AND no loss.
# `reject` would answer 554 at CONNECT and turn one outage into a wave of
# bounces (R2 measured both). Postfix has no per-action knob, so the
# strict-but-temporary default is the one that holds both invariants.
smtpd_milters = inet:rspamd:11332
milter_default_action = tempfail
milter_protocol = 6

message_size_limit = 26214400
mailbox_size_limit = 0

# Container has no syslog: log to stdout so `docker logs` shows everything.
maillog_file = /dev/stdout